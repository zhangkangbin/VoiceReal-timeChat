# 仅在 AI_PROVIDER=openai 时需要；留空表示只使用本地 LM Studio。
OPENAI_API_KEY=
# OpenAI Realtime 模式使用的模型名称。
OPENAI_REALTIME_MODEL=gpt-realtime
# AI_PROVIDER=lmstudio 使用局域网本地模型；改为 openai 才会连接云端。
AI_PROVIDER=lmstudio
# LM Studio 的 OpenAI-compatible API 根地址和已加载的模型标识。
LMSTUDIO_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=google/gemma-3-12b
# 预留给其他本地适配器的地址和模型；当前默认链路不会读取它们。
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# faster-whisper 的模型、设备和 beam search 宽度；CUDA 不可用时会自动回退 CPU。
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_BEAM_SIZE=5
# 每个 WebSocket 会话最多保留多少轮用户/助手消息。
MAX_HISTORY_TURNS=30
# 可选：关闭工具调用或长期记忆，便于排查不支持 tools 的本地模型。
# FUNCTION_CALLS_ENABLED=true
# MEMORY_ENABLED=true
# MAX_TOOL_CALL_ROUNDS=3
